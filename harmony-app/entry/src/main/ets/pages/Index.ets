import { Api, LoginInput, LoginResult, PatrolState, Task, Device, AlertItem, MessageItem, ActionInput } from '../model/Api';

@Entry
@Component
struct Index {
 @State private logged:boolean=false;
 @State private tab:number=0;
 @State private base:string='http://10.0.2.2:8080';
 @State private username:string='worker';
 @State private feedback:string='';
 @State private feedbackNotice:string='';
 @State private password:string='WorkerDemo2026!';
 @State private tasks:Task[]=[];
 @State private devices:Device[]=[];
 @State private alerts:AlertItem[]=[];
 @State private messages:MessageItem[]=[];
 @State private selected:string='';
 @State private error:string='';
 @State private busy:boolean=false;
 @State private checkedPower:boolean=false;
 @State private checkedRecovery:boolean=false;
 @State private checkedSite:boolean=false;
 @State private note:string='';
 @State private videoUrl:string='';
 @State private playing:boolean=false;
 private timer:number=-1;
 private readonly teal:string='#147F72';

 aboutToDisappear():void { if(this.timer!==-1) clearInterval(this.timer); }
 private async login():Promise<void>{
  this.busy=true;this.error='';
  try{
   if(!/^https?:\/\/[^\s]+$/.test(this.base))throw new Error('请输入完整的http或https服务地址');
   Api.base=this.base.replace(/\/$/,'');
   const body:LoginInput={username:this.username,password:this.password};
   const result=JSON.parse(await Api.request('/auth/login',JSON.stringify(body),true)) as LoginResult;
   if(result.role!=='worker')throw new Error('请使用现场作业人员账号');
   Api.token=result.token;this.logged=true;await this.refresh();
   if(this.timer!==-1)clearInterval(this.timer);
   this.timer=setInterval(()=>{this.refresh();},5000);
  }catch(e){this.error=(e as Error).message;}finally{this.busy=false;}
 }
 private async refresh():Promise<void>{try{const s=JSON.parse(await Api.request('/state')) as PatrolState;this.tasks=s.tasks;this.devices=s.devices;this.alerts=s.alerts;this.messages=s.messages;if(this.selected===''&&this.tasks.length>0){this.selected=this.tasks[0].id;this.videoUrl=this.tasks[0].videoUrl||'';}this.error='';}catch(e){this.error=(e as Error).message;}}
 private async connectVideo():Promise<void>{if(this.playing){this.playing=false;return;}const t=this.current();if(!t)return;try{await Api.request('/tasks/'+t.id+'/video',JSON.stringify({url:this.videoUrl}),true,true);this.playing=true;await this.refresh();}catch(e){this.error=(e as Error).message;}}
 private current():Task|undefined {return this.tasks.find((t:Task)=>t.id===this.selected);}
 private label(s:string):string{switch(s){case 'dispatched':return '待进场';case 'running':return '巡检中';case 'paused':return '已暂停';case 'completed':return '待复核';case 'reviewed':return '已归档';default:return s;}}
 private async act(action:string):Promise<void>{
  if(this.busy)return;
  const t=this.current();if(!t)return;
  if(action==='start'&&!(this.checkedPower&&this.checkedRecovery&&this.checkedSite)){this.error='请完成电源、回收与现场环境三项确认';return;}
  if(action==='finish'&&this.note.trim()===''){this.error='请填写本次巡检结果与现场备注';return;}
  this.busy=true;
  try{const body:ActionInput={action:action,note:this.note||'现场人员暂停',weather:'dry'};await Api.request('/tasks/'+t.id+'/action',JSON.stringify(body),true);await this.refresh();}catch(e){this.error=(e as Error).message;}finally{this.busy=false;}
 }
 private async ack(id:string):Promise<void>{try{await Api.request('/alerts/'+id+'/ack','{}',true);await this.refresh();}catch(e){this.error=(e as Error).message;}}
 private async acknowledgeMessage(id:string):Promise<void>{try{await Api.request('/messages/'+id+'/ack','{}',true);await this.refresh();}catch(e){this.error=(e as Error).message;}}
 private async sendFeedback():Promise<void>{const t=this.current();if(!t){this.error='请先选择一条任务';return;}if(this.feedback.trim()==='')return;this.busy=true;try{await Api.request('/tasks/'+t.id+'/messages',JSON.stringify({text:this.feedback}),true);this.feedback='';this.feedbackNotice='现场反馈已发送';await this.refresh();}catch(e){this.error=(e as Error).message;}finally{this.busy=false;}}
 @Builder private pill(text:string){Text(text).fontSize(13).fontColor(this.teal).backgroundColor('#E4F2EB').padding({left:10,right:10,top:6,bottom:6}).borderRadius(6)}
 @Builder private heading(kicker:string,title:string){Column({space:8}){Text(kicker).fontSize(12).fontColor('#87A295').letterSpacing(2);Text(title).fontSize(26).fontWeight(FontWeight.Bold).fontColor('#1D3936')}.alignItems(HorizontalAlign.Start).width('100%').margin({top:10,bottom:22})}
 @Builder private metric(label:string,value:string){Column({space:8}){Text(value).fontSize(23).fontWeight(FontWeight.Medium).fontColor('#315C4E');Text(label).fontSize(12).fontColor('#8D9D91')}.layoutWeight(1).padding(18).backgroundColor(Color.White).borderRadius(12)}
 @Builder private checkRow(text:string,checked:boolean,index:number){Row({space:12}){Checkbox({name:'check'+index,group:'preflight'}).select(checked).selectedColor(this.teal).onChange((v:boolean)=>{if(index===0)this.checkedPower=v;else if(index===1)this.checkedRecovery=v;else this.checkedSite=v;});Text(text).fontSize(14).fontColor('#587365').layoutWeight(1)}.width('100%').padding({top:7,bottom:7})}
 @Builder private taskCard(t:Task){Column({space:14}){Row(){this.pill(this.label(t.status));Blank();Text(t.id).fontSize(12).fontColor('#91A395')}.width('100%');Text(t.name).fontSize(17).fontWeight(FontWeight.Medium).fontColor('#264B3E').width('100%');Row(){Text(t.start+'  →  '+t.end).fontSize(15).fontColor('#587764');Blank();Text(t.device).fontSize(13).fontColor('#91A395')}.width('100%');Progress({value:t.progress,total:100,type:ProgressType.Linear}).color(this.teal).backgroundColor('#EDF2EC').width('100%');Row(){Text('进度 '+t.progress+'%').fontSize(12).fontColor('#91A395');Blank();Text('查看任务 →').fontSize(14).fontColor(this.teal)}.width('100%')}.padding(20).backgroundColor(Color.White).borderRadius(14).width('100%').alignItems(HorizontalAlign.Start).onClick(()=>{this.selected=t.id;this.checkedPower=false;this.checkedRecovery=false;this.checkedSite=false;this.note=t.note;this.videoUrl=t.videoUrl||'';this.playing=false;this.tab=1;})}
 @Builder private home(){Column({space:16}){this.heading('FIELD OPERATIONS','今天，从这里出发');Row({space:12}){this.metric('分配任务',this.tasks.length.toString());this.metric('待处理告警',this.alerts.filter((a:AlertItem)=>!a.ack).length.toString())}.width('100%');Text('我的巡检任务').fontSize(15).fontWeight(FontWeight.Medium).fontColor('#3B5D4B').width('100%').margin({top:12});ForEach(this.tasks,(t:Task)=>{this.taskCard(t)},(t:Task)=>t.id);if(this.tasks.length===0){Text('暂无下发任务，请等待管理人员派发。').fontSize(14).fontColor('#91A395').padding(30)}Text('晴天巡检 · 低水位作业 · 全程保持回收路径').fontSize(12).fontColor('#9BAC9C').padding(12)}.width('100%')}
 @Builder private work(){Column({space:16}){this.heading('ON-SITE WORKSPACE','现场巡检');if(this.current()!==undefined){Text(this.current()!.name).fontSize(18).fontWeight(FontWeight.Medium).fontColor('#315440').width('100%');Row(){this.pill(this.label(this.current()!.status));Blank();Text(this.current()!.start+' → '+this.current()!.end).fontSize(15).fontColor('#64846D')}.width('100%');Column({space:12}){Text('巡检管段').fontSize(14).fontColor('#8AA18D').width('100%');Text(this.current()!.pipes.join('   →   ')).fontSize(15).fontColor('#315C42').width('100%');Text('当前位置采用管段＋参考里程，现场按井号核对。').fontSize(12).fontColor('#91A395').width('100%')}.padding(18).backgroundColor(Color.White).borderRadius(12).width('100%');Column(){if(this.playing&&this.videoUrl!==''){Video({src:this.videoUrl}).autoPlay(true).controls(true).width('100%').height(210).onError(()=>{this.error='视频地址无法播放，请检查摄像头网关和编码格式';this.playing=false;})}else{Text('◉').fontSize(38).fontColor('#71AD99');Text('尚未连接摄像头').fontSize(15).fontColor('#C2D6CB').margin({top:12});}}.width('100%').height(210).justifyContent(FlexAlign.Center).backgroundColor('#193832').borderRadius(12);TextInput({text:this.videoUrl,placeholder:'输入网关HTTPS/HTTP视频地址'}).fontSize(14).onChange((v:string)=>{this.videoUrl=v;this.playing=false;});Button(this.playing?'停止预览':'连接视频').width('100%').backgroundColor('#DFECE3').fontColor(this.teal).enabled(this.videoUrl.startsWith('http')).onClick(()=>{this.connectVideo();});if(this.devices.length>0){Row({space:8}){this.metric('电量',this.devices[0].lastSeen?this.devices[0].battery.toFixed(0)+'%':'—');this.metric('里程',this.devices[0].lastSeen?this.devices[0].distance.toFixed(1)+'m':'—')}.width('100%');Text(this.devices[0].lastSeen===''?'暂无设备上报记录':'最后上报 '+this.devices[0].lastSeen).fontSize(12).fontColor('#9BAC9C')}
 Column(){Text('进场前确认').fontSize(14).fontWeight(FontWeight.Medium).fontColor('#315440').width('100%');this.checkRow('电量、摄像头和通信已检查',this.checkedPower,0);this.checkRow('回收绳与机械连接已检查',this.checkedRecovery,1);this.checkRow('晴天、低水位，现场许可已确认',this.checkedSite,2)}.padding(16).backgroundColor(Color.White).borderRadius(12).width('100%');TextArea({text:this.note,placeholder:'填写现场情况、异常位置和巡检结果'}).height(100).fontSize(15).onChange((v:string)=>this.note=v);if(this.current()!.status==='dispatched'||this.current()!.status==='paused'){Button('确认条件，开始巡检').backgroundColor(this.teal).width('100%').enabled(!this.busy).onClick(()=>this.act('start'));}if(this.current()!.status==='running'){Button('暂停任务').backgroundColor('#C4833E').width('100%').enabled(!this.busy).onClick(()=>this.act('pause'));Button('提交巡检结果').backgroundColor(this.teal).width('100%').enabled(!this.busy).onClick(()=>this.act('finish'));}Text('异常时先停止设备运动，再暂停任务；现场急停与回收按作业规程执行。').fontSize(12).fontColor('#9BAC9C').lineHeight(18)}else{Text('请先从任务列表选择一条任务').fontColor('#91A395').padding(40)}}.width('100%')}
 @Builder private inbox(){Column({space:16}){this.heading('MESSAGES & ALERTS','消息与告警');Text(this.current()===undefined?'请在任务页选择任务后发送反馈':'当前任务：'+this.current()!.name).fontSize(14).fontColor('#567564').width('100%');TextArea({text:this.feedback,placeholder:'填写现场情况、告警处理或任务反馈'}).height(95).fontSize(15).onChange((v:string)=>this.feedback=v);Button('发送现场反馈').width('100%').backgroundColor(this.teal).enabled(!this.busy&&this.feedback.trim()!=='').onClick(()=>this.sendFeedback());if(this.feedbackNotice!==''){Text(this.feedbackNotice).fontSize(15).fontColor(this.teal).width('100%');}ForEach(this.alerts,(a:AlertItem)=>{Column({space:10}){Row(){this.pill(a.ack?'已确认':'现场告警');Blank();Text(a.task).fontSize(12).fontColor('#91A395')}.width('100%');Text(a.text).fontSize(14).fontColor('#775C37').width('100%');if(!a.ack){Button('确认收到').fontSize(14).backgroundColor('#EEDFC7').fontColor('#886B40').onClick(()=>this.ack(a.id))}}.padding(18).backgroundColor('#FFF8ED').borderRadius(12).width('100%')},(a:AlertItem)=>a.id);ForEach(this.messages,(m:MessageItem)=>{Column({space:12}){Text((m.sender==='admin'?'总台指令':'现场反馈')+' · '+m.task).fontSize(13).fontColor(this.teal).width('100%');Text(m.text).fontSize(14).fontColor('#365A44').width('100%');Text(m.at).fontSize(14).fontColor('#A0AD9E').width('100%');if(m.sender!==this.username&&!m.acknowledged){Button('确认收到').fontSize(14).backgroundColor('#E2EFE5').fontColor(this.teal).onClick(()=>this.acknowledgeMessage(m.id));}else{Text(m.acknowledged?'对方已确认':'等待对方确认').fontSize(14).fontColor('#8DA18E').width('100%');}}.padding(20).backgroundColor(Color.White).borderRadius(12).width('100%')},(m:MessageItem)=>m.id);if(this.alerts.length===0&&this.messages.length===0){Text('暂无消息。管理端消息与设备告警将自动同步。').fontSize(14).fontColor('#91A395').padding(32)}}.width('100%')}
 @Builder private settings(){Column({space:18}){this.heading('CONNECTION & PROFILE','连接设置');Text('服务地址').fontSize(15).fontColor('#587365').width('100%');Text(this.base).fontSize(15).fontColor(this.teal).width('100%');Text('作业账号：'+this.username).fontSize(15).fontColor('#587365').width('100%');Text('手机与电脑处于同一局域网时，服务地址填写电脑局域网IP和8080端口；后端需使用局域网启动脚本，并由系统防火墙允许相应端口。').fontSize(14).fontColor('#91A395').lineHeight(23);Text('任务、指令与巡检结果自动同步\n设备状态按现场上报更新\n管网资料由管理中心统一维护').fontSize(14).fontColor('#91A395').lineHeight(23);Button('刷新任务资料').width('100%').backgroundColor(this.teal).onClick(()=>this.refresh());Button('退出并修改连接').width('100%').backgroundColor('#E4ECE4').fontColor(this.teal).onClick(()=>{this.logged=false;Api.token='';this.playing=false;if(this.timer!==-1){clearInterval(this.timer);this.timer=-1;}})}.width('100%')}
 build(){Column(){if(!this.logged){Scroll(){Column({space:22}){Text('管脉探微').fontSize(15).letterSpacing(4).fontColor(this.teal).width('100%');Text('每一段巡检，\n都有迹可循。').fontSize(34).fontWeight(FontWeight.Bold).fontColor('#1D3936').lineHeight(49).width('100%').margin({top:30,bottom:8});Text('城市无压重力流排水管道 · 星闪中继巡检').fontSize(15).fontColor('#8EA38F').width('100%');TextInput({text:this.base,placeholder:'后端服务地址'}).onChange((v:string)=>this.base=v);TextInput({text:this.username,placeholder:'作业账号'}).onChange((v:string)=>this.username=v);TextInput({text:this.password,placeholder:'登录密码'}).type(InputType.Password).onChange((v:string)=>this.password=v);if(this.error!==''){Text(this.error).fontSize(14).fontColor('#B76843').width('100%')}Button(this.busy?'正在连接…':'连接并登录').width('100%').height(50).backgroundColor(this.teal).enabled(!this.busy).onClick(()=>this.login());Text('请使用管理员分配的作业账号。\n连接地址由片区管理员提供。').fontSize(13).fontColor('#9BAC9C').lineHeight(21).width('100%')}.padding(28).width('100%')}.layoutWeight(1)}else{Row(){Text('管脉探微').fontSize(19).fontWeight(FontWeight.Bold).fontColor('#244D3A');Blank();this.pill('现场作业端')}.width('100%').padding({left:22,right:22,top:18,bottom:14}).backgroundColor(Color.White);if(this.error!==''){Text(this.error).fontSize(13).fontColor('#AD653F').padding(12).backgroundColor('#FFF0DF').width('100%')}Scroll(){Column(){if(this.tab===0){this.home()}else if(this.tab===1){this.work()}else if(this.tab===2){this.inbox()}else{this.settings()}}.width('100%').padding(20)}.layoutWeight(1).width('100%');Row(){ForEach(['任务','现场','消息','我的'],(name:string,index:number)=>{Column({space:6}){Text(index===0?'▤':index===1?'◉':index===2?'✉':'⚙').fontSize(20).fontColor(this.tab===index?this.teal:'#A3B2A0');Text(name).fontSize(13).fontColor(this.tab===index?this.teal:'#A3B2A0')}.layoutWeight(1).padding({top:12,bottom:18}).onClick(()=>{this.tab=index;})})}.width('100%').backgroundColor(Color.White)}}.height('100%').width('100%').backgroundColor('#F4F7F5')}
}
